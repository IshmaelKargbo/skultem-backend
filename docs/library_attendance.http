# Library Attendance - see docs/LIBRARY_ATTENDANCE.md. Every call needs a signed-in user's token.
@BaseURL=http://localhost:8080/api/v1/library/attendance
@Token=<access token from POST /api/v1/auth/login>

### Overview figures (libraryPeriods = Library periods on this year's timetable)
GET {{BaseURL}}/overview
Authorization: Bearer {{Token}}

### Add a Library period to the timetable (the school does this; no subject or teacher)
POST http://localhost:8080/api/v1/timetable
Authorization: Bearer {{Token}}
Content-Type: application/json

{ "period": "<periodId>", "day": "FRIDAY", "room": "<roomId>", "color": "bg-primary/5 border-primary/20", "kind": "LIBRARY" }

### Check in one or more students (all or nothing unless eligibleOnly is true)
POST {{BaseURL}}/visits/check-in
Authorization: Bearer {{Token}}
Idempotency-Key: 6b1f2c1e-0d6a-4c3e-9f3f-1a2b3c4d5e6f
Content-Type: application/json

{ "studentIds": ["STD-2026-0001", "STD-2026-0002"], "eligibleOnly": false }

### Who is in the library now (status: ALL, OPEN, UNRESOLVED, CHECKED_OUT, RESOLVED)
GET {{BaseURL}}/visits?status=OPEN&page=1&size=20
Authorization: Bearer {{Token}}

### Check out
POST {{BaseURL}}/visits/<visitId>/check-out
Authorization: Bearer {{Token}}

### Follow up a visit never checked out (after the school day)
POST {{BaseURL}}/visits/<visitId>/resolve
Authorization: Bearer {{Token}}
Content-Type: application/json

{ "reason": "Left with the class at the bell" }

### Class library sessions for a week (status: ALL, UPCOMING, IN_PROGRESS, COMPLETED, CANCELLED, INCOMPLETE)
GET {{BaseURL}}/sessions?from=2026-10-26&to=2026-11-01&status=ALL
Authorization: Bearer {{Token}}

### Open a session to take the register
POST {{BaseURL}}/sessions/open
Authorization: Bearer {{Token}}
Content-Type: application/json

{ "timetableEntryId": "<timetable entry id>", "date": "2026-10-28" }

### Save marks
PUT {{BaseURL}}/sessions/<sessionId>/marks
Authorization: Bearer {{Token}}
Content-Type: application/json

{ "marks": [
    { "recordId": "<recordId>", "status": "PRESENT" },
    { "recordId": "<recordId>", "status": "EXCUSED", "excuseReason": "Sick bay" }
] }

### Add a student to the register (reason required)
POST {{BaseURL}}/sessions/<sessionId>/roster
Authorization: Bearer {{Token}}
Content-Type: application/json

{ "studentId": "STD-2026-0003", "reason": "Joined the class this week" }

### Finalize (refused while anyone is unmarked)
POST {{BaseURL}}/sessions/<sessionId>/finalize
Authorization: Bearer {{Token}}

### Correct a finalized mark (principal-level only)
POST {{BaseURL}}/sessions/<sessionId>/records/<recordId>/correct
Authorization: Bearer {{Token}}
Content-Type: application/json

{ "status": "PRESENT", "reason": "Was in the library; marked by mistake" }

### Cancel a session nobody has opened
POST {{BaseURL}}/sessions/cancel
Authorization: Bearer {{Token}}
Content-Type: application/json

{ "timetableEntryId": "<timetable entry id>", "date": "2026-10-30", "reason": "Library used for exams" }

### Totals from finalized registers
GET {{BaseURL}}/totals?from=2026-10-01&to=2026-10-31
Authorization: Bearer {{Token}}

### Export (csv or pdf)
GET {{BaseURL}}/export/totals?format=pdf&from=2026-10-01&to=2026-10-31
Authorization: Bearer {{Token}}
